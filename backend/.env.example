SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Render PostgreSQL: paste Render's DATABASE_URL here in production.
DATABASE_URL=

# Optional MySQL settings. Leave USE_MYSQL=false if using SQLite locally or DATABASE_URL on Render.
USE_MYSQL=false
MYSQL_DB=ride_share
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
